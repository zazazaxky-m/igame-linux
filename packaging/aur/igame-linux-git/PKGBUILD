# Maintainer: zazazaxky-m
pkgname=igame-linux-git
_pkgname=igame-linux
pkgver=1.0.0.r0.g0000000
pkgrel=1
pkgdesc="Unofficial lighting, overclocking and fan control for Colorful iGame GeForce cards (iGame Center replacement)"
arch=('x86_64')
url="https://github.com/zazazaxky-m/igame-linux"
license=('GPL-3.0-or-later')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'nvidia-utils' 'libpulse' 'hicolor-icon-theme')
makedepends=('git' 'cmake' 'qt6-tools')
provides=("$_pkgname")
conflicts=("$_pkgname")
install=igame-linux.install
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "$_pkgname"
    # v1.0.0-3-gabc1234 -> 1.0.0.r3.gabc1234; before the first tag: 1.0.0.rN.gabc1234
    git describe --long --tags --abbrev=7 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' ||
        printf "1.0.1.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
    cmake -B build -S "$_pkgname" \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

check() {
    ctest --test-dir build --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$_pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
